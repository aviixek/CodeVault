# =======================================================
# CodeVault Environment Configuration Template
# Copy this file to .env and configure strong passwords
# DO NOT commit real passwords or .env to version control
# =======================================================

# Database connection configuration (used by CodeVault app)
DB_HOST=db
DB_PORT=3306
DB_NAME=codevault
DB_USER=codevault_user
DB_PASSWORD=change_me_strong_app_password

# MySQL Container Root Password (for initial container setup only)
MYSQL_ROOT_PASSWORD=change_me_strong_root_password
