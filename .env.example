# =======================================================
# CodeVault Environment Configuration Template
# Copy this file to .env and set your strong passwords before launching:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / macOS:      cp .env.example .env
# =======================================================

DB_HOST=db
DB_PORT=3306
DB_NAME=codevault
DB_USER=codevault_user

# Set strong, unique passwords for local deployment (MANDATORY)
DB_PASSWORD=your_strong_app_password_here
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
